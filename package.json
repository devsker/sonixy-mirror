{
	"name": "sonixy",
	"version": "0.3.1",
	"description": "simple audio collection manager",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"check": "tsc --noEmit",
		"lint": "eslint . && prettier --check . && pnpm lint:rust",
		"lint:rust": "cd src-tauri && cargo clippy -- -D warnings && cargo fmt -- --check",
		"format": "prettier --write . && cd src-tauri && cargo fmt",
		"tauri": "tauri"
	},
	"license": "MIT",
	"dependencies": {
		"@crabnebula/tauri-plugin-drag": "^2.1.0",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"lucide-react": "^0.575.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.16.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tauri-apps/cli": "^2.11.2",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"typescript": "~5.6.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^6.4.3"
	}
}
