{
  "name": "sonixy",
  "version": "0.2.1",
  "description": "simple audio collection manager",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . && prettier --check . && pnpm lint:rust",
    "lint:rust": "cd src-tauri && cargo clippy -- -D warnings && cargo fmt -- --check",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2",
    "jiti": "^2.6.1",
    "lucide-svelte": "^1.0.1",
    "webview-window": "link:@tauri-apps/api/webview-window"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.5.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.6.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.0.3"
  }
}
