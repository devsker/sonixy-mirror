{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Sonixy",
	"version": "0.3.1",
	"identifier": "app.sonixy.desktop",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Sonixy",
				"width": 1000,
				"height": 700,
				"decorations": false,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost asset://localhost; media-src 'self' asset: https://asset.localhost asset://localhost",
			"assetProtocol": {
				"enable": true,
				"scope": ["**"]
			}
		}
	},
	"plugins": {
		"drag": {}
	},
	"bundle": {
		"active": true,
		"targets": ["deb", "rpm", "dmg", "app", "msi", "nsis"],
		"resources": ["icons/32x32.png"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
